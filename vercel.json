{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/workspace-fwVeVJXC.js",
      "destination": "/startup-recovery.js"
    }
  ],
  "buildCommand": "npm --prefix web ci --no-fund && npm --prefix web run build && python deploy/prepare_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "includeFiles": "{casepacks/**,api/publication.json,web/public/third-party-notices.txt}",
      "excludeFiles": "{docs/**,submission/**,tests/**,casepacks/standards/*.nc,web/node_modules/**,web/src/**,web/e2e/**,web/benchmarks/**,web/science-tests/**,science/verify_*.py,.venv/**,.runtime/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/startup-recovery.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/workspace-fwVeVJXC.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/((?!api/docs).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-QczEk0LgQo7mnv86G+X4OYzXemr96gAeome7cOABO7Y='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
